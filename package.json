{
  "name": "prompt-maker",
  "version": "0.1.0",
  "description": "AI prompt creator, optimizer, and management platform",
  "type": "module",
  "bin": {
    "prompt-maker": "bin/prompt-maker.js",
    "prompt-maker-mcp": "bin/prompt-maker-mcp.js"
  },
  "files": [
    "bin",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:mcp": "esbuild src/mcp/bin.ts --bundle --platform=node --format=esm --target=node20 --banner:js=\"#!/usr/bin/env node\" --outfile=bin/prompt-maker-mcp.js && chmod +x bin/prompt-maker-mcp.js",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --banner:js=\"#!/usr/bin/env node\" --outfile=bin/prompt-maker.js && chmod +x bin/prompt-maker.js",
    "build:all": "npm run build && npm run build:mcp && npm run build:cli",
    "mcp": "node bin/prompt-maker-mcp.js",
    "publish:infisical": "infisical run --env=prod -- bash -c 'npm set //registry.npmjs.org/:_authToken=$NPM_TOKEN && npm publish --access public'",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "keywords": [
    "prompt-engineering",
    "ai",
    "prompt-maker"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
